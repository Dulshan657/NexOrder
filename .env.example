# Supabase (required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase admin (for seed/migration scripts only — never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_PROJECT_REF=your-project-ref
# Personal access token from https://supabase.com/dashboard/account/tokens.
# Required by the Management API scripts: supabase/apply-sql.mjs (raw SQL, the
# only path that works on Windows) and supabase/apply-auth-config.mjs.
SUPABASE_ACCESS_TOKEN=your-personal-access-token

# Seed script
SEED_USER_PASSWORD=Password123!

# Optional
VITE_IMAGE_CDN_URL=https://ayam.com/images/com_hikashop/upload/thumbnails/263x263f
# Serve Storage-hosted images through Supabase's on-the-fly resize/WebP CDN
# (render/image). Requires a PAID Supabase plan — leave "false" on the free
# tier; OptimizedImage falls back to the raw object URL automatically.
VITE_SUPABASE_IMAGE_TRANSFORMS=false
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Transactional email (Edge Function secrets — NOT read from this file)
# ─────────────────────────────────────────────────────────────────────────────
# `send-email` reads these from the Supabase Edge Function secret store, not
# from .env.local. Listed here only so the full set is discoverable in one
# place. Set them with:
#
#   npx supabase secrets set RESEND_API_KEY=re_xxx --project-ref lsgkznyiabqitqfpveey
#
# Full procedure: docs/runbooks/enable-email.md
#
# RESEND_API_KEY  required to send at all. Absent => send-email returns
#                 {ok:true, sent:false, reason:'not_configured'} and order
#                 placement is unaffected. This is the ONLY switch.
# EMAIL_FROM      optional. Verified sender, e.g. "Nex Order <orders@yourdomain>".
#                 Defaults to "Nex Order <onboarding@resend.dev>", which Resend
#                 only delivers to the account owner's own address.
# EMAIL_REPLY_TO  optional. Omitted from the payload entirely when unset.
# APP_URL         optional. Root for deep links in emails.
#                 Defaults to https://nexorder.vercel.app
# ALERT_EMAIL     optional. Recipient for the health-cron `system_alert`
#                 template. Unset => alerts are a no-op (same self-disable
#                 philosophy as RESEND_API_KEY).

# Show the click-to-fill demo account roster (and its shared password) on the
# login page. These are WORKING CREDENTIALS for real accounts including an
# Admin, so the roster is a public credential disclosure wherever it renders.
# Defaults ON, because the current deployment is a sales-demo surface.
# Set to "false" (here and in the Vercel project env) before the first paying
# client — that strips the emails and the password from the built bundle.
# Turning it off does NOT invalidate the credentials; rotate them separately.
VITE_SHOW_DEMO_LOGINS=true
