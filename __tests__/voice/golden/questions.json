{
  "about": "Nex golden questions. Asked in order, one session per role, by scripts/nex-golden.mjs (npm run nex:golden:dev). Facts are paths into the LAST output of the named tool, so expected values are whatever dev's data says that day. Cases marked refuse are questions Nex cannot answer today; a later PR that adds the tool changes the case.",
  "cases": [
    {
      "id": "admin-placed-this-month",
      "role": "Admin",
      "question": "How many orders came in this month?",
      "tools": [
        "get_sales_summary"
      ],
      "states": [
        "get_sales_summary.orderCount"
      ]
    },
    {
      "id": "admin-shipped-last-month",
      "role": "Admin",
      "question": "How many orders did we ship last month?",
      "tools": [
        "get_sales_summary"
      ],
      "states": [
        "get_sales_summary.shippedCount"
      ]
    },
    {
      "id": "admin-revenue-vs-last-month",
      "role": "Admin",
      "question": "What was revenue this month compared to last month, and why did it change?",
      "tools": [
        "get_sales_summary"
      ],
      "states": [
        "get_sales_summary.revenue",
        "get_sales_summary.previous.revenue"
      ],
      "note": "2026-10-29: a 2 to 30 Sep window was called last month"
    },
    {
      "id": "admin-customers-drove-change",
      "role": "Admin",
      "question": "Which customers drove that change?",
      "tools": [
        "get_sales_summary"
      ]
    },
    {
      "id": "admin-best-customer-year",
      "role": "Admin",
      "question": "Who was our best customer this year?",
      "tools": [
        "get_sales_summary"
      ],
      "states": [
        "get_sales_summary.topCustomers.0.name"
      ]
    },
    {
      "id": "admin-charlie-target",
      "role": "Admin",
      "question": "How is Charlie tracking against his target?",
      "tools": [
        "get_target_progress"
      ]
