{
  "name": "copy-of-curatif-order-system-v1.3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "node -e \"process.env.ANALYZE='1';require('child_process').execSync('vite build',{stdio:'inherit',env:process.env})\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "check:csp": "node scripts/check-csp.mjs",
    "check:overlays": "node scripts/check-overlays.mjs",
    "deploy:dev": "node scripts/deploy.mjs --env=dev",
    "deploy:amadiya": "node scripts/deploy.mjs --env=amadiya",
    "migrate:dev": "node supabase/migrate.mjs --env=dev",
    "migrate:amadiya": "node supabase/migrate.mjs --env=amadiya",
    "auth:config:dev": "node supabase/apply-auth-config.mjs --env=dev",
    "auth:config:amadiya": "node supabase/apply-auth-config.mjs --env=amadiya",
    "auth:config:check:dev": "node supabase/apply-auth-config.mjs --env=dev --check",
    "auth:config:check:amadiya": "node supabase/apply-auth-config.mjs --env=amadiya --check",
    "fn:deploy:dev": "node supabase/ops/deploy-functions.mjs --env=dev",
    "fn:deploy:amadiya": "node supabase/ops/deploy-functions.mjs --env=amadiya",
    "secrets:dev": "node supabase/ops/secrets.mjs --env=dev",
    "secrets:amadiya": "node supabase/ops/secrets.mjs --env=amadiya",
    "secrets:check:dev": "node supabase/ops/secrets.mjs --env=dev --check",
    "secrets:check:amadiya": "node supabase/ops/secrets.mjs --env=amadiya --check",
    "crons:dev": "node supabase/ops/schedule-crons.mjs --env=dev",
    "crons:amadiya": "node supabase/ops/schedule-crons.mjs --env=amadiya",
    "crons:list:dev": "node supabase/ops/schedule-crons.mjs --env=dev --list",
    "crons:list:amadiya": "node supabase/ops/schedule-crons.mjs --env=amadiya --list",
    "bootstrap:admin:amadiya": "node supabase/ops/bootstrap-admin.mjs --env=amadiya",
    "export:demo": "node supabase/ops/export-demo.mjs --env=dev",
    "po-fixtures": "node tests/fixtures/po-samples/generate.mjs",
    "po-inject": "node tests/fixtures/po-samples/inject.mjs --env=dev",
    "po-demo-seed": "node tests/fixtures/po-samples/demo-seed.mjs --env=dev",
    "po-sydney-seed": "node tests/fixtures/po-samples/sydney-tools-seed.mjs --env=dev",
    "po-repco-seed": "node tests/fixtures/po-samples/repco-seed.mjs --env=dev",
    "po-tridon-account": "node tests/fixtures/po-samples/tridon-demo-seed.mjs --env=dev",
    "seed:tridon-demo": "npm run po-tridon-account && npm run po-sydney-seed && npm run po-repco-seed",
    "po-v2food-account": "node tests/fixtures/po-samples/v2food-demo-seed.mjs --env=dev",
    "po-yj-seed": "node tests/fixtures/po-samples/young-jacksons-seed.mjs --env=dev",
    "seed:v2food-demo": "npm run po-v2food-account && npm run po-yj-seed",
    "demo:tridon:seed": "node tridon-demo/seed.mjs --env=dev",
    "demo:tridon:reset": "node tridon-demo/reset.mjs --env=dev",
    "demo:tridon:pdfs": "node tridon-demo/generate.mjs",
    "demo:wie:seed": "node wie-demo/seed.mjs --env=dev",
    "demo:wie:reset": "node wie-demo/reset.mjs --env=dev",
    "warehouse:main:seed": "tsx warehouse-main/seed.mjs --env=dev",
    "warehouse:main:reset": "tsx warehouse-main/reset.mjs --env=dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "embed:products:dev": "node supabase/embed-products.mjs --env=dev",
    "embed:products:amadiya": "node supabase/embed-products.mjs --env=amadiya"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.99.0",
    "@zxing/browser": "^0.2.1",
    "browser-image-compression": "^2.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@vercel/config": "^0.5.6",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "docx": "^9.6.1",
    "jsdom": "^29.1.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.4"
  }
}
